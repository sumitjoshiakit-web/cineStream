# GEMINI_API_KEY: Google Gemini API Key for AI Mood Matcher
# For Vercel deployments, configure this in your Vercel Project Settings > Environment Variables
GEMINI_API_KEY=

# TMDB_API_KEY: The Movie Database API Key (v3 API key or v4 Bearer Token)
# Free from https://www.themoviedb.org/settings/api
# In Vercel, set under Project Settings > Environment Variables
TMDB_API_KEY=

# Optional: If deploying to a purely static host without serverless functions (e.g. GitHub Pages)
# VITE_GEMINI_API_KEY=
# VITE_TMDB_API_KEY=
